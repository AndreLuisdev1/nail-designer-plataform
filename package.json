{
  "name": "agenda-da-rachel",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "tokens": "node .claude/skills/design-system/scripts/generate-tokens.cjs --config tokens.json -o tokens.css",
    "check:contrast": "node scripts/check-contrast.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "theme": "astryx theme build src/theme/rachel.ts --out src/theme/built/rachel.css",
    "check:theme": "astryx theme build src/theme/rachel.ts --out src/theme/built/rachel.css --check"
  },
  "dependencies": {
    "@astryxdesign/core": "^0.7.17",
    "@astryxdesign/theme-neutral": "^0.7.17",
    "@stylexjs/stylex": "^0.19.2",
    "@tailwindcss/postcss": "^4.3.5",
    "lucide-react": "^1.81.0",
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.5"
  },
  "devDependencies": {
    "@astryxdesign/cli": "0.7.17",
    "@axe-core/playwright": "^4.14.1",
    "@playwright/test": "^1.65.1",
    "@stylexjs/eslint-plugin": "^0.19.2",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/node": "^26.6.11",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.6",
    "jsdom": "^31.0.1",
    "prettier": "^3.10.1",
    "typescript": "^6.0.3",
    "vitest": "^5.1.2"
  }
}
